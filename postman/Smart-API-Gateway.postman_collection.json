        },
        {
          "name": "Unblock client",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/unblock?key=sim:attacker",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "unblock"
              ],
              "query": [
                {
                  "key": "key",
                  "value": "sim:attacker"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
